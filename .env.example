# AppForge Environment Variables
# Copy this file to .env and fill in your values

# App
VITE_APP_NAME=AppForge
VITE_APP_URL=https://sstoken.space

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Supabase
VITE_SUPABASE_URL=https://ixqoosixhahrsgwoxyme.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=appforge

# API Keys (optional)
# Server-only: never prefix provider secrets with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Dragon Arena scene generation (Hugging Face only)
# Configure one or more server-side tokens. Requests rotate through the pool.
HF_TOKEN_1=
HF_TOKEN_2=
HF_TOKEN_3=
# Current default used by api/dragon-image.js; override if you prefer another HF Inference text-to-image model.
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Optional client-side overrides: users may supply personal provider keys/tokens in Dragon Arena.
# Personal credentials are sent only for the active request and are never stored by AppForge servers.
VITE_WEATHERAPI_KEY=
VITE_PARIFLOW_API_KEY=
VITE_COINMARKETCAP_API_KEY=
VITE_COINPAPRIKA_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# GitHub
GITHUB_TOKEN=
