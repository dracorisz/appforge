# AppForge Environment Variables
# Copy this file to .env and fill in your values

# App
VITE_APP_NAME=AppForge
VITE_APP_URL=https://sstoken.space

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Supabase
VITE_SUPABASE_URL=https://ixqoosixhahrsgwoxyme.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=

# MySQL
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=appforge

# API Keys (optional)
# Server-only: never prefix the OpenRouter key with VITE_.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=openrouter/free
# Optional client-side override: users may supply their own key in Dragon Arena.
# Personal keys are sent only for the active request and are never stored by AppForge.
VITE_WEATHERAPI_KEY=
VITE_PARIFLOW_API_KEY=
VITE_COINMARKETCAP_API_KEY=
VITE_COINPAPRIKA_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# GitHub
GITHUB_TOKEN=
