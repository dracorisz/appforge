# AppForge environment variables
# Copy this file to .env.local and fill in your values. Never commit real values.
# Variables prefixed with VITE_ are compiled into the browser bundle.
# See docs/DEPLOYMENT.md for the full reference.

# App
VITE_APP_NAME=AppForge
VITE_APP_URL=https://www.sstoken.space

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never prefix with VITE_ and never use it in browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Dragon Arena — server-only AI keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_IMAGE_MODEL=openrouter/free
# Hugging Face fallback pool for scene generation, rotated per request.
HF_TOKEN_1=
HF_TOKEN_2=
HF_TOKEN_3=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# Optional client-side provider overrides
VITE_WEATHERAPI_KEY=
VITE_PARIFLOW_API_KEY=
VITE_COINMARKETCAP_API_KEY=
VITE_COINPAPRIKA_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# CI/CD only
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
