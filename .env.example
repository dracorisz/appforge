# AppForge Environment Variables
# Copy this file to .env and fill in your values.

# App
VITE_APP_NAME=AppForge
VITE_APP_URL=https://www.sstoken.space

# Vercel
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Supabase
VITE_SUPABASE_URL=https://ixqoosixhahrsgwoxyme.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# Dragon Arena Hugging Face Inference Providers
# Configure one or more server-side tokens. Requests rotate through the pool.
# Tokens need permission to make calls to Hugging Face Inference Providers.
HF_TOKEN_1=
HF_TOKEN_2=
HF_TOKEN_3=

# Optional preferred models. Each is prepended to the built-in fallback rotation.
HF_TEXT_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:cheapest
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Optional personal-key compatibility for signed-in Dragon Arena users.
# Shared AppForge GM traffic no longer depends on OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional client-side integrations
VITE_WEATHERAPI_KEY=
VITE_PARIFLOW_API_KEY=
VITE_COINMARKETCAP_API_KEY=
VITE_COINPAPRIKA_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# GitHub automation/deployment only; never expose this through VITE_.
GITHUB_TOKEN=
