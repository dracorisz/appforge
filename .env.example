# AppForge Environment Variables
# Copy this file to .env and fill in only the integrations you actually use.

# App
VITE_APP_NAME=AppForge
VITE_APP_URL=https://www.sstoken.space

# Vercel deployment automation only. Do not expose these through VITE_.
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Supabase
VITE_SUPABASE_URL=https://ixqoosixhahrsgwoxyme.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# Story Studio + Desktop Buddy Hugging Face Inference Providers
# Configure one or more server-side tokens. Requests rotate through the pool.
# Tokens need permission to call Hugging Face Inference Providers.
HF_TOKEN_1=
HF_TOKEN_2=
HF_TOKEN_3=

# Optional preferred models. Each is prepended to the built-in fallback rotation.
HF_TEXT_MODEL=openai/gpt-oss-20b:fastest
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional personal-key compatibility for signed-in AI users.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional authenticated text fallback (server only; never use a VITE_ prefix).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# YouTube Data API server-side public-read integration.
YOUTUBE_API_KEY=

# Private Google Cloud / Cloud Run experiment worker.
# These are worker/operator variables, not browser variables. The worker must remain
# IAM-protected and WORKER_ENABLED should stay false until budget + IAM are verified.
GOOGLE_CLOUD_PROJECT=
WORKER_BUCKET=
WORKER_ENABLED=false

# Vercel -> Google Workload Identity Federation bridge for Desktop Buddy Vertex AI.
# SERVER ONLY. Do not prefix these with VITE_ and do not use a service-account JSON key.
# Vercel supplies its OIDC token at runtime through @vercel/oidc. The Google provider
# must be restricted to the reviewed production Vercel principal/claims.
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_CLOUD_WORKER_URL=
GCP_WORKER_BUCKET=

# Optional client-side integrations that are explicitly browser-safe/public IDs.
VITE_WEATHERAPI_KEY=
VITE_COINMARKETCAP_API_KEY=
VITE_COINPAPRIKA_API_KEY=
VITE_GOOGLE_CLIENT_ID=

# GitHub automation only; never expose this through VITE_.
GITHUB_TOKEN=

# Companion private agent. Keep all provider/admin tokens server-side.
# Configure the approval secret in Vercel as a sensitive variable; never commit a real value.
COMPANION_OWNER_EMAIL=dracorisz@gmail.com
COMPANION_ACTION_SECRET=replace-with-a-random-secret-at-least-32-characters
COMPANION_ALLOWED_REPOSITORIES=dracorisz/appforge
COMPANION_ALLOWED_VERCEL_PROJECTS=prj_duzco4XEzLRNCPs3n0VkWpRDusZq
COMPANION_ALLOWED_SUPABASE_PROJECTS=ixqoosixhahrsgwoxyme
COMPANION_VERTEX_CHAT_MODEL=gemini-3.8-flash
COMPANION_VERTEX_CODE_MODEL=gemini-4-argon
COMPANION_VERTEX_LOCATION=global
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=team_w5zHVgvHs060CuaxQt23OSyr
SUPABASE_ACCESS_TOKEN=
