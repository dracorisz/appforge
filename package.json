{
  "name": "appforge",
  "private": true,
  "version": "1.27.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-api.js",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "audit:apps": "node scripts/audit-app-integrity.mjs",
    "audit:standalone": "node scripts/audit-standalone-boundaries.mjs",
    "docs:env": "node scripts/generate-env-capabilities.mjs",
    "docs:env-check": "node scripts/generate-env-capabilities.mjs --check",
    "verify:release": "npm run audit:apps && npm run audit:standalone && npm run docs:env-check && npm run lint && npm run typecheck && npm test && npm run build",
    "version:set": "node scripts/set-version.mjs",
    "db:migrate": "echo 'Migrations run via CI/CD'",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/oidc": "3.8.7",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
