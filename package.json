{
  "name": "appforge",
  "private": true,
  "version": "1.26.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-api.js",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 50",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "audit:apps": "node scripts/audit-app-integrity.mjs",
    "verify:release": "npm run audit:apps && npm run lint && npm run typecheck && npm test && npm run build",
    "version:set": "node scripts/set-version.mjs",
    "db:migrate": "echo 'Migrations run via CI/CD'",
    "deploy": "vercel --prod",
    "deploy:preview": "vercel"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/oidc": "3.8.7",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
